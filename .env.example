# Copy to .env.local and fill in. Never commit real values; .env and .env.local are gitignored.
# Mock mode is the default and needs nothing here.

AI_PROVIDER=mock        # mock | anthropic | gemini
AI_MODEL=               # model id lives ONLY here; empty with a real provider => safe fall back to mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SESSION_SECRET=         # REQUIRED in production (signs the demo session cookie); dev generates one with a warning
TRUST_PROXY=            # set to 1 only behind a proxy that overwrites x-forwarded-for

# Optional
# ANTHROPIC_BASE_URL=   # proxy or test stand-in
# GEMINI_BASE_URL=      # proxy or test stand-in
# AI_TIMEOUT_MS=
# AI_TOTAL_BUDGET_MS=
# AI_MAX_TOKENS=
# AI_RATE_PER_MIN=
# AI_RATE_GLOBAL_PER_MIN=
# SITE_URL=            # public address (https://...), used for the link-preview image; Vercel production domains are detected
# DATA_DIR=             # defaults to ./.data
# POLL_MS=              # in-app notification polling, min 200, default 5000
